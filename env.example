# Copy to .env and edit. docker compose reads .env from this directory.
# INGI_REPO and INGI_REF are build args: changing them needs
# `docker compose up -d --build`.

# INGInious source (role default in ntnu-inginious-ansible)
INGI_REPO=https://github.com/INGInious/INGInious
INGI_REF=37f4438ea8aff3e61841a8d1cf068af7fedf7452
# tdt4120-atest pins 2f0ce3b0aad393cd6c4f037e99f6d766ac56b29d

# http://localhost:8080 -- plain http, no TLS, no oauth
HTTP_PORT=8080

# Course directory served as tasks_directory
TASKS_DIR=./data/tasks

# Seeded into Mongo on every frontend start. A different ADMIN_USER also needs
# changing in superadmins: in configuration.yaml.
ADMIN_USER=superadmin
ADMIN_PASSWORD=superadmin
